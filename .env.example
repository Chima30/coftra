# Copy to .env (never commit it). Deployment uses a Foundry keystore account, not a raw key:
#   cast wallet import coftra-deployer --interactive
# then pass --account coftra-deployer to forge script.

# --- RPC (public defaults work; replace with your own provider if rate limited)
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# --- deployment knobs (all optional)
DEPLOYMENT_NAME=base-sepolia
RC_FUNDING_WEI=0                            # lREACT to the RC balance (not billed; leave 0)
RC_RESERVE_WEI=2000000000000000000          # lREACT deposited to the RC reserves (pays reactions)
VAULT_CALLBACK_FUNDING_WEI=2000000000000000 # Base Sepolia ETH kept by the vault for callback fees
DEMO_FAST_CRON=true                         # true = Cron100 (~2 min), false = Cron1000 (~17 min)
RC_RETRY_SECONDS=300
VAULT_ADMIN=                                # defaults to the deployer

# --- frontend (apps/web/.env.local). Public values only.
# sepolia.base.org limits eth_getLogs to 200 blocks, too small for task history
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
